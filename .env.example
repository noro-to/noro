# Copy to .env and fill in. .env is gitignored; never commit it.

# OpenRouter key. The classify step (jev) always uses it. The writing steps use it
# too unless NORO_WRITER=claude-cli.
OPENROUTER_API_KEY=sk-or-...

# Who runs the writing steps (draft, panel, revise):
#   openrouter  pay per token through OpenRouter (default)
#   claude-cli  your own installed and logged-in Claude Code, on your own Claude
#               subscription, for personal use on your own machine. noro never
#               sees your Claude login. See "Writing on your Claude subscription"
#               in the README.
NORO_WRITER=openrouter

# Writing model for the draft, panel and revision steps.
NORO_DRAFT_MODEL=anthropic/claude-opus-5.5
NORO_PANEL_MODEL=anthropic/claude-opus-5.5

# Classifier for the classify step (OpenRouter decisions endpoint).
NORO_CLASSIFY_MODEL=typesafe/jev-1.13

# Optional
# NORO_CLAUDE_BIN=claude
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# NORO_PYTHON=python3
# NORO_STATE_DIR=.noro
