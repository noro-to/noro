# Copy to .env (this folder) or ~/.config/noro/.env and fill in. .env is
# gitignored; never commit it. Run `noro init` to write it for you and
# `noro doctor` to check it. Docs: docs/install/providers.md

# ---- Writing model (draft, panel, revise): <provider>:<model-id>
# Default: OpenRouter with Claude Opus 5.5, billed per token.
NORO_MODEL=openrouter:anthropic/claude-opus-5.5
# Uncomment and paste your key. A placeholder value is ignored (noro doctor
# warns), so it can't hide a real key in ~/.config/noro/.env.
# OPENROUTER_API_KEY=

# Other providers, each with its own standard key variable:
# NORO_MODEL=anthropic:claude-opus-5-5          # + ANTHROPIC_API_KEY
# NORO_MODEL=ollama:qwen3.8:27b                 # local, no key (docs/install/local.md)
# NORO_MODEL=claude-cli:claude-opus-5-5         # your own logged-in Claude Code, personal use
# NORO_MODEL=codex-cli:default                  # your own logged-in Codex CLI, personal use
#                                               # (docs/install/subscriptions.md)

# Optional per-step overrides, same format:
# NORO_DRAFT_MODEL=anthropic:claude-opus-5-5    # draft and revise
# NORO_PANEL_MODEL=openrouter:deepseek/deepseek-v4-pro
# One run only: noro this report.csv --model openrouter:anthropic/claude-opus-5.5

# Legacy: NORO_WRITER=claude-cli still works as an alias for
# NORO_MODEL=claude-cli:claude-opus-5-5.

# OpenAI-compatible servers (LiteLLM, vLLM, llama.cpp); also moves ollama / lmstudio:
# NORO_BASE_URL=http://localhost:8000
# NORO_API_KEY=

# ---- Classify (docs/install/classify.md)
# Unset: NORO_CLASSIFY_BASE_URL, else jev on OpenRouter (OPENROUTER_API_KEY),
# else jev on TypeSafe (TYPESAFE_API_KEY), else rules.
# NORO_CLASSIFY=jev                             # jev | rules | writer
# NORO_CLASSIFY_BASE_URL=http://localhost:11434 # a local decision model
# NORO_CLASSIFY_MODEL=nimble                    # default typesafe/jev-1.13 on OpenRouter
# TYPESAFE_API_KEY=

# ---- Optional
# NORO_CLAUDE_BIN=claude
# NORO_CODEX_BIN=codex
# OPENROUTER_BASE_URL=https://openrouter.ai/api
# NORO_PYTHON=python3
# NORO_STATE_DIR=.noro
