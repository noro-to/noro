{
  "name": "noro",
  "version": "0.2.0",
  "description": "Open-source framework that turns raw ad-platform exports into short paid-media reports where every number is traced. Bring your own OpenRouter key.",
  "license": "MIT",
  "type": "module",
  "repository": "github:noro-to/noro",
  "bin": {
    "noro": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/adapters',{recursive:true});for(const f of fs.readdirSync('src/adapters'))if(/\\.ya?ml$/i.test(f))fs.copyFileSync('src/adapters/'+f,'dist/adapters/'+f);fs.chmodSync('dist/cli.js',0o755)\"",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "noro": "tsx src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
